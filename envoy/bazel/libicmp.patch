+int icmp_recv_noblock(struct libicmp *obj, uint8_t type, char *payload, size_t len)
+{
+  if (!obj)
+  {
+    errno = EINVAL;
+    return -1;
+  }
+
+  int result = 0;
+  struct pollfd pfd = {obj->sd, POLLIN | POLLPRI, 0};
+
+  result = poll(&pfd, 1, 0);
